rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }
    function reviewedApplication(uid) {
      let data = request.resource.data;
      return isAdmin() && validApplication(data, uid)
        && resource.data.propietarioId == uid
        && data.diff(resource.data).affectedKeys().hasOnly(['estado', 'revisadoEn', 'revisadoPor', 'motivoRechazo'])
        && data.revisadoEn == request.time && data.revisadoPor == request.auth.uid
        && !exists(/databases/$(database)/documents/vendedores/$(uid))
        && ((data.estado == 'rechazada' && resource.data.estado == 'pendiente'
          && data.motivoRechazo is string && data.motivoRechazo.size() > 0 && data.motivoRechazo.size() <= 1000)
        || (data.estado == 'aprobada' && resource.data.estado in ['pendiente', 'aprobada']
          && data.motivoRechazo == null
          && getAfter(/databases/$(database)/documents/vendedores/$(uid)).data.propietarioId == uid
          && getAfter(/databases/$(database)/documents/vendedores/$(uid)).data.creadoEn == request.time));
    }
    function approvedSeller(uid) {
      let data = request.resource.data;
      let application = getAfter(/databases/$(database)/documents/solicitudesVendedores/$(uid)).data;
      return isAdmin()
        && application.estado == 'aprobada' && application.propietarioId == uid
        && application.revisadoPor == request.auth.uid && application.revisadoEn == request.time
        && data.keys().hasAll(['propietarioId', 'nombreNegocio', 'descripcion', 'telefonoContacto', 'municipio', 'estado', 'creadoEn', 'actualizadoEn'])
        && data.keys().hasOnly(['propietarioId', 'nombreNegocio', 'descripcion', 'telefonoContacto', 'municipio', 'estado', 'creadoEn', 'actualizadoEn'])
        && data.propietarioId == uid && data.estado == 'activo'
        && data.nombreNegocio is string && data.nombreNegocio.size() > 0
        && data.nombreNegocio == application.nombreNegocio
        && data.descripcion is string && data.descripcion == application.descripcion
        && data.telefonoContacto is string && data.telefonoContacto == application.telefonoContacto
        && data.municipio is string && data.municipio == application.municipio
        && data.creadoEn == request.time && data.actualizadoEn == request.time;
    }
    function nonempty(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function validUser(data) {
      return data.keys().hasAll(['nombre', 'correo', 'telefono', 'creadoEn', 'actualizadoEn'])
        && data.keys().hasOnly(['nombre', 'correo', 'telefono', 'creadoEn', 'actualizadoEn'])
        && nonempty(data.nombre, 120) && nonempty(data.correo, 320)
        && (data.telefono == null || nonempty(data.telefono, 30))
        && data.creadoEn is timestamp && data.actualizadoEn == request.time;
    }
    function validApplication(data, uid) {
      return data.keys().hasAll(['propietarioId', 'nombreNegocio', 'descripcion', 'telefonoContacto', 'municipio', 'estado', 'enviadoEn', 'revisadoEn', 'revisadoPor', 'motivoRechazo'])
        && data.keys().hasOnly(['propietarioId', 'nombreNegocio', 'descripcion', 'telefonoContacto', 'municipio', 'estado', 'enviadoEn', 'revisadoEn', 'revisadoPor', 'motivoRechazo'])
        && data.propietarioId == uid && nonempty(data.nombreNegocio, 120)
        && nonempty(data.descripcion, 2000) && nonempty(data.telefonoContacto, 30) && nonempty(data.municipio, 120)
        && data.enviadoEn is timestamp;
    }
    function pendingApplication(uid) {
      let data = request.resource.data;
      return isOwner(uid) && validApplication(data, uid)
        && !exists(/databases/$(database)/documents/vendedores/$(uid))
        && data.estado == 'pendiente' && data.enviadoEn == request.time
        && data.revisadoEn == null && data.revisadoPor == null && data.motivoRechazo == null;
    }
    match /usuarios/{uid} {
      allow create: if isOwner(uid) && validUser(request.resource.data) && request.resource.data.creadoEn == request.time && request.resource.data.correo == request.auth.token.email;
      allow read: if isOwner(uid);
      allow update: if isOwner(uid) && validUser(request.resource.data) && request.resource.data.correo == resource.data.correo && request.resource.data.creadoEn == resource.data.creadoEn;
      allow delete: if false;
    }
    match /solicitudesVendedores/{uid} {
      allow create: if pendingApplication(uid);
      allow read: if isOwner(uid) || isAdmin();
      allow update: if reviewedApplication(uid) || (resource.data.estado == 'rechazada' && pendingApplication(uid));
      allow delete: if false;
    }
    match /vendedores/{uid} {
      allow read: if request.auth != null;
      allow create: if approvedSeller(uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'actualizadoEn'])
        && request.resource.data.estado in ['activo', 'suspendido']
        && request.resource.data.actualizadoEn == request.time;
      allow delete: if false;
    }
    match /productos/{id} {
      allow read: if request.auth != null && (resource.data.vendedorId == request.auth.uid
        || (resource.data.estado == 'publicado'
          && get(/databases/$(database)/documents/vendedores/$(resource.data.vendedorId)).data.estado == 'activo'));
      // Only server functions write products and inventory atomically.
      allow create, update: if false;
      allow delete: if false;
    }
    match /cotizaciones/{id} {
      allow read: if request.auth != null && (resource.data.compradorId == request.auth.uid || resource.data.vendedorId == request.auth.uid);
      allow write: if false;
    }
    match /pedidos/{id} {
      allow read: if request.auth != null && (resource.data.compradorId == request.auth.uid || resource.data.vendedorId == request.auth.uid);
      allow write: if false;
    }
    match /movimientosInventario/{id} {
      allow read: if request.auth != null && (resource.data.vendedorId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
