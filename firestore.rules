rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }
    function reviewedApplication(uid) {
      let data = request.resource.data;
      return isAdmin()
        && resource.data.propietarioId == uid
        && data.diff(resource.data).affectedKeys().hasOnly(['estado', 'revisadoEn', 'revisadoPor', 'motivoRechazo'])
        && data.revisadoEn == request.time && data.revisadoPor == request.auth.uid
        && !exists(/databases/$(database)/documents/vendedores/$(uid))
        && ((data.estado == 'rechazada' && resource.data.estado == 'pendiente'
          && data.motivoRechazo is string && data.motivoRechazo.size() > 0 && data.motivoRechazo.size() <= 1000)
        || (data.estado == 'aprobada' && resource.data.estado in ['pendiente', 'aprobada']
          && data.motivoRechazo == null
          && getAfter(/databases/$(database)/documents/vendedores/$(uid)).data.propietarioId == uid
          && getAfter(/databases/$(database)/documents/vendedores/$(uid)).data.creadoEn == request.time));
    }
    function approvedSeller(uid) {
      let data = request.resource.data;
      let application = getAfter(/databases/$(database)/documents/solicitudesVendedores/$(uid)).data;
      return isAdmin()
        && application.estado == 'aprobada' && application.propietarioId == uid
        && application.revisadoPor == request.auth.uid && application.revisadoEn == request.time
        && data.keys().hasAll(['propietarioId', 'nombreNegocio', 'descripcion', 'telefonoContacto', 'municipio', 'estado', 'creadoEn', 'actualizadoEn'])
        && data.keys().hasOnly(['propietarioId', 'nombreNegocio', 'descripcion', 'telefonoContacto', 'municipio', 'estado', 'creadoEn', 'actualizadoEn'])
        && data.propietarioId == uid && data.estado == 'activo'
        && data.nombreNegocio is string && data.nombreNegocio.size() > 0
        && data.nombreNegocio == application.nombreNegocio
        && data.descripcion is string && data.descripcion == application.descripcion
        && data.telefonoContacto is string && data.telefonoContacto == application.telefonoContacto
        && data.municipio is string && data.municipio == application.municipio
        && data.creadoEn == request.time && data.actualizadoEn == request.time;
    }
    function activeSeller() {
      return request.auth != null
        && exists(/databases/$(database)/documents/vendedores/$(request.auth.uid))
        && get(/databases/$(database)/documents/vendedores/$(request.auth.uid)).data.estado == 'activo'
        && get(/databases/$(database)/documents/vendedores/$(request.auth.uid)).data.propietarioId == request.auth.uid;
    }
    function validProduct(data) {
      return data.keys().hasAll(['vendedorId', 'nombre', 'descripcion', 'categoria', 'presentacion', 'cantidadMinimaPedido', 'cantidadDisponible', 'precioUnitarioCentavos', 'moneda', 'estado', 'rutasImagenes', 'creadoEn', 'actualizadoEn'])
        && data.keys().hasOnly(['vendedorId', 'nombre', 'descripcion', 'categoria', 'presentacion', 'cantidadMinimaPedido', 'cantidadDisponible', 'precioUnitarioCentavos', 'moneda', 'estado', 'rutasImagenes', 'creadoEn', 'actualizadoEn'])
        && data.vendedorId == request.auth.uid
        && data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 120
        && data.descripcion is string && data.descripcion.size() <= 2000
        && data.categoria is string && data.categoria.size() > 0 && data.categoria.size() <= 60
        && data.presentacion is string && data.presentacion.size() > 0 && data.presentacion.size() <= 120
        && data.cantidadMinimaPedido is int && data.cantidadMinimaPedido >= 1 && data.cantidadMinimaPedido <= 1000000
        && data.cantidadDisponible is int && data.cantidadDisponible >= 0 && data.cantidadDisponible <= 1000000
        && data.precioUnitarioCentavos is int && data.precioUnitarioCentavos > 0 && data.precioUnitarioCentavos <= 999999999
        && data.moneda == 'MXN'
        && data.estado in ['borrador', 'publicado', 'pausado']
        && data.rutasImagenes is list
        && data.creadoEn is timestamp && data.actualizadoEn == request.time;
    }
    match /usuarios/{uid} {
      allow create: if isOwner(uid) && request.resource.data.correo == request.auth.token.email;
      allow read: if isOwner(uid);
      allow update: if isOwner(uid) && request.resource.data.correo == resource.data.correo && request.resource.data.creadoEn == resource.data.creadoEn;
      allow delete: if false;
    }
    match /solicitudesVendedores/{uid} {
      allow create: if isOwner(uid) && request.resource.data.propietarioId == request.auth.uid && request.resource.data.estado == 'pendiente';
      allow read: if isOwner(uid) || isAdmin();
      allow update: if reviewedApplication(uid);
      allow delete: if false;
    }
    match /vendedores/{uid} {
      allow read: if request.auth != null;
      allow create: if approvedSeller(uid);
      allow update, delete: if false;
    }
    match /productos/{id} {
      allow read: if request.auth != null && (resource.data.estado == 'publicado' || resource.data.vendedorId == request.auth.uid);
      allow create: if activeSeller() && validProduct(request.resource.data)
        && request.resource.data.creadoEn == request.time && request.resource.data.rutasImagenes.size() == 0;
      allow update: if activeSeller() && resource.data.vendedorId == request.auth.uid && validProduct(request.resource.data)
        && request.resource.data.creadoEn == resource.data.creadoEn
        && request.resource.data.rutasImagenes == resource.data.rutasImagenes;
      allow delete: if false;
    }
    match /cotizaciones/{id} {
      allow read: if request.auth != null && (resource.data.compradorId == request.auth.uid || resource.data.vendedorId == request.auth.uid);
      allow write: if false;
    }
    match /pedidos/{id} {
      allow read: if request.auth != null && (resource.data.compradorId == request.auth.uid || resource.data.vendedorId == request.auth.uid);
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
