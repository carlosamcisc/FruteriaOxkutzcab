rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.correo == request.auth.token.email;
      allow read: if isOwner(userId);
      allow update: if isOwner(userId)
        && request.resource.data.correo == resource.data.correo
        && request.resource.data.creadoEn == resource.data.creadoEn;
      allow delete: if false;
    }

    match /solicitudesVendedores/{userId} {
      allow create: if isOwner(userId)
        && request.resource.data.propietarioId == request.auth.uid
        && request.resource.data.estado == "pendiente";
      allow read: if isOwner(userId);
      allow update, delete: if false;
    }

    // Perfil público del negocio: lo consulta cualquier cuenta autenticada.
    match /vendedores/{vendedorId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Las consultas del catálogo deben filtrar por estado == "publicado".
    match /productos/{productoId} {
      allow read: if request.auth != null
        && resource.data.estado == "publicado";
      allow write: if false;
    }

    // El comprador consulta solo sus cotizaciones y pedidos (filtrando por compradorId).
    match /cotizaciones/{cotizacionId} {
      allow read: if request.auth != null
        && resource.data.compradorId == request.auth.uid;
      allow write: if false;
    }

    match /pedidos/{pedidoId} {
      allow read: if request.auth != null
        && resource.data.compradorId == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
  }
}
