{
  "name": "fruteria-oxkutzcab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test:rules": "firebase emulators:exec --only firestore --project demo-fruteria-admin \"node --test tests/firestore-admin.rules.test.mjs\"",
    "test:commerce": "firebase emulators:exec --only firestore --project demo-fruteria-admin \"node --test --test-concurrency=1 tests/firestore-admin.rules.test.mjs tests/commerce-spark.test.mjs\"",
    "test:flow": "firebase emulators:exec --only auth,firestore --project demo-fruteria-admin \"node --test tests/commerce-flow.test.mjs\"",
    "admin:claim": "node scripts/set-admin-claim.mjs",
    "migrate:firestore-schema": "node scripts/migrate-firestore-schema.mjs",
    "migrate:spark-inventory": "node scripts/migrate-spark-inventory.mjs"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "firebase": "^12.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase-admin": "^13.10.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
